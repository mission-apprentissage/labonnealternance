<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Lien de connexion" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text text-body" padding="10px 0px 10px 0px">
              Bonjour <%= data.first_name %> <%= data.last_name %>,
              <br />
            </mj-text>          
            <mj-text mj-class="text text-body" padding="10px 0px 10px 0px">
              Pour accéder à votre espace, merci de cliquer sur le lien ci-dessous :
              <br />
            </mj-text>          
            <mj-button href="<%= data.connexion_url %>" align="center" background-color="#000091" border-radius="0px" border="1px solid #000091" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" href="#" inner-padding="4px 0px 4px 0px" line-height="24px" padding="10px 0px 10px 0px" width="184px">
              Accéder à mon espace
            </mj-button>          
            <mj-text mj-class="text" color="#161616" font-size="14px" font-style="italic" font-weight="700" line-height="24px" padding="10px 0px 10px 0px">
              Attention, ce lien est valide pendant 15 minutes.
              <br />
            </mj-text>
            <mj-text mj-class="text" color="#161616" font-size="14px" font-weight="400" line-height="22px" padding="10px 0px 10px 0px">
              Si le bouton ne fonctionne pas, copiez le lien suivant dans votre navigateur :
              <br /><%= data.connexion_url %>
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous souhaitez vous connecter à votre compte pour déposer des offres d'emploi en alternance.",
        faqAnchor: "recruteur",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
