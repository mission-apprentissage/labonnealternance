<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Candidature" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text" color="#000091" font-size="18px" font-weight="700" line-height="20px" padding="0px 0px 16px 0px">
              Vous avez reçu une candidature !
              <br />
            </mj-text>
            <mj-text mj-class="text text-body" padding="0px 0px 16px 0px">
              <span style="font-weight: 700;">
                <%= data.applicant_first_name %> <%= data.applicant_last_name %></span> a répondu à <a href="<%= data.jobUrl %>" style="text-decoration: underline; color: inherit;">votre offre</a>
                <%= data.jobPartnerLabel %><% if (data.job_searched_by_user) { %> sur le métier <b><%= data.job_searched_by_user %></b> <% } %>
                pour l’entreprise <b><%= data.company_name %></b><% if (data.company_siret) { %>, SIRET <%= data.company_siret %><% } %>.
                <br />
            </mj-text>
            
            <mj-text align="center" color="#161616" css-class="text" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="16px" font-weight="700" line-height="24px" padding="0px 0px 16px 0px">
              Quelle suite voulez-vous donner à cette candidature ?
              <br />
            </mj-text>

            <mj-button href="<%= data.meetCandidateUrl %>" align="center" background-color="#18753c" border-radius="0px" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" inner-padding="8px 0px 8px 0px" line-height="24px" padding="0px 0px 16px 0px" width="184px">
              Répondre au candidat
            </mj-button>
            <mj-button href="<%= data.refuseCandidateUrl %>" align="center" background-color="#ce0500" border-radius="0px" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" inner-padding="8px 0px 8px 0px" line-height="24px" padding="0px 0px 16px 0px" width="184px">
              Refuser la candidature
            </mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column"  padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text" color="#3A3A3A" font-size="14px" font-weight="700" line-height="22px">
              Candidature de <%= data.applicant_first_name %> <%= data.applicant_last_name %>
              <br /><br />
            </mj-text>

            <mj-text mj-class="text title">
              Son message personnalisé
              <br /><br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="4px 0px 0px 0px">
              <%- data.applicant_message_to_company %>
              <% if (!data.applicant_message_to_company) { %>
                <span style="font-size: 16px; color: #929292;">Aucun message renseigné</span>
              <% } %>
              <br /><br />
            </mj-text>

            <% if (data.applicant_answers_to_recruiter_questions?.length) { %>
                <mj-text mj-class="text title">
                  <%= data.applicant_answers_to_lba_questions ? "Ses motivations" : "Ses réponses à vos questions" %>
                  <br /><br />
                </mj-text>
                <% data.applicant_answers_to_recruiter_questions.forEach(function(answerData) { %>
                  <mj-text mj-class="text text-body">
                    <span style="font-weight: 700;"><%= answerData.question %></span>
                    <br />
                    <span>
                      <%- answerData.answer %>
                    </span>
                    <br />
                    <br />
                  </mj-text>
                <% }) %>
              <% } %>
            
            <% if (data.applicant_contract_duration || data.applicant_contract_start || data.applicant_formation_description || data.applicant_rythm_description) { %>
              <mj-text mj-class="text title">
                Sa recherche d’alternance
                <br /><br />
              </mj-text>
              <mj-text mj-class="text text-body">
            <% } %>

              <% if (data.applicant_contract_duration) { %>
                <span style="font-weight: 700;">Durée du contrat souhaitée :</span>
                <br />
                <span>
                  <%= data.applicant_contract_duration %>
                </span>
                <br />
                <br />
              <% } %>
              
              <% if (data.applicant_contract_start) { %>
                <span style="font-weight: 700;">Début de contrat souhaité :</span>
                <br />
                <span>
                  <%= data.applicant_contract_start %>
                </span>
                <br />
                <br />
              <% } %>

              <% if (data.applicant_formation_description) { %>
                <span style="font-weight: 700;">Informations sur l’école et la formation :</span>
                <br />
                <span>
                  <%- data.applicant_formation_description %>
                </span>
                <br />
                <br />
              <% } %>

              <% if (data.applicant_rythm_description) { %>
                <span style="font-weight: 700;">Rythme de l’alternance (école/entreprise) :</span>
                <br />
                <span>
                  <%- data.applicant_rythm_description %>
                </span>
                <br />
                <br />
              <% } %>
            
            <% if (data.applicant_contract_duration || data.applicant_contract_start || data.applicant_formation_description || data.applicant_rythm_description) { %>
              </mj-text>
            <% } %>

            <mj-text mj-class="text title">
              Ses coordonnées
              <br /><br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="4px 0px 0px 0px">
              <b>Téléphone :</b>
              <br />
              <%= data.applicant_phone %>
              <br /><br />

              <b>E-mail :</b>
              <br />
              <a href="mailto:<%= data.applicant_email %>" style="text-decoration: underline; color: inherit">
                <%= data.applicant_email %>
              </a>
              <br /><br /><br />

              <span style="font-size: 16px;">
                <b><i>📎 Vous trouverez le CV du candidat en pièce jointe.</i></b>
              </span>
              <br />
            </mj-text>
            
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-spacer height="24px"></mj-spacer>

      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column"  padding="23px" vertical-align="middle" width="100%">
            <% if (data.job_type === "offres_emploi_lba") { %>
              <mj-text mj-class="text title" line-height="24px" padding="0px 0px 12px 0px">
                Une question ?
                <br />
              </mj-text>

              <mj-text mj-class="text" color="#161616" font-size="14px" font-weight="400" line-height="24px" padding="0px 0px 12px 0px">
                📝 <a href="<%= data.cancelJobUrl %>" style="text-decoration: underline; color: inherit;" target="_blank">
                  Supprimer mon offre
                </a>
              </mj-text>
              <mj-text mj-class="text" color="#161616" font-size="14px" font-weight="400" line-height="24px" padding="0px 0px 0px 0px">
                💬 <a href="<%= data.faqUrl %>" style="text-decoration: underline; color: inherit;" target="_blank">
                  Consulter la FAQ
                </a>
              </mj-text>
            <% } else if (data.job_type === "offres_emploi_partenaires") { %>
              <mj-text mj-class="text title" line-height="24px" padding="0px 0px 12px 0px">
                Pourquoi vous recevez une candidature via La bonne alternance ?
                <br />
              </mj-text>

              <mj-text mj-class="text" color="#161616" font-size="14px" font-weight="400" line-height="24px" padding="0px 0px 12px 0px">
                Afin de maximiser vos chances de trouver le bon candidat, <%= data.jobPartnerLabel %> rediffuse ses offres en alternance auprès de La bonne alternance. Pour modifier ou supprimer votre offre, nous vous invitons à le faire sur le site sur lequel vous avez déposé l'offre.
              </mj-text>
            <% } %>
          </mj-column>
        </mj-group>
      </mj-section>

      <%- include("partials/footer", {
        data,
        contactReason: "Vous recevez cette candidature car vous avez déposé une offre sur le service de dépôt d'offre simplifié de La bonne alternance.",
        contact: false,
      }) %>
    </mj-column>
  </mj-body>
</mjml>
