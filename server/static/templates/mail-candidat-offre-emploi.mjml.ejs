<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Candidat - Confirmation de candidature spontanée" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="16px 0px 16px 0px">
              Votre candidature<%= data.job_type === "recruteurs_lba" ? " spontanée" : "" %> a bien été envoyée<%= data.applicationWebsiteOrigin %> à
              <br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="10px 0px 10px 0px">
              <% if (data.job_title === "recruteurs_lba") { %>
                <a href="<%= data.urlOfDetailNoUtm %>" style="text-decoration: underline; color: inherit; font-weight: 700;">
              <% } %>
              <span style="font-weight: 700;"><%= data.company_name %></span><% if (data.job_title === "recruteurs_lba") { %></a><% } %>, <%= data.company_address %><% if (data.job_title !== "recruteurs_lba") { %>
               pour le poste 
               <a href="<%= data.urlOfDetailNoUtm %>" style="text-decoration: underline; color: inherit; font-weight: 700;"><span style="font-weight: 700;"><%= data.job_title %></span></a><% } %>.
              <br />
            </mj-text>

            <mj-button align="center" background-color="#000091" border-radius="0px" border="1px solid #000091" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" inner-padding="4px 0px 4px 0px" line-height="24px" padding="10px 0px 10px 0px" width="238px" href="<%= data.sendOtherApplicationsUrl %>">
              J’envoie d’autres candidatures
            </mj-button>

            
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-spacer height="24px">
      </mj-spacer>

      <% if (data.company_phone) { %>
        <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
          <mj-group>
            <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
              <mj-text mj-class="text text-body">              
                📞 Si l'établissement <%= data.company_name %> ne vous a pas répondu le <%= data.reminderDate %>, relancez le par téléphone au <span style="font-weight: 700;"><%= data.company_phone %>.</span>
                <br /><br />

                <span style="font-weight: 700;">Exemple de relance téléphonique :</span>
                <span style="font-style: italic;">
                  <br />
                  “Bonjour,
                  <br />
                  Je suis <%= data.applicant_first_name %> <%= data.applicant_last_name %>. Je vous appelle car je vous ai envoyé ma candidature par mail le <%= data.applicationDate %> pour un poste d'apprenti <%= data.job_title %>. N'ayant pas reçu de réponse, je me permets de vous relancer car je suis vraiment très intéressé·e par votre entreprise. Je serai heureux·se de vous expliquer plus en détail ma motivation lors d'un rendez-vous. Pourriez-vous me dire à qui je dois m’adresser pour savoir où en est ma candidature et quand puis-je espérer recevoir une réponse ?”
                  <br />
                </span>
              </mj-text>
            </mj-column>
          </mj-group>
        </mj-section>
        <mj-spacer height="24px"></mj-spacer>
      <% } %>

      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text" color="#3A3A3A" font-size="14px" font-weight="700" line-height="16px" padding="0px 0px 24px 0px">
              Rappel de votre candidature
            </mj-text>

            <mj-text mj-class="text title">
              Votre message personnalisé
              <br /><br />
            </mj-text>
            
            <mj-text mj-class="text text-body">
              <%- data.applicant_message_to_company %>
              <% if (!data.applicant_message_to_company) { %>
                <span style="font-size: 16px; color: #929292;">Aucun message renseigné</span>
              <% } %>
              <br />
              <br />
              
              <span style="font-weight: 700;">Pièce jointe envoyée :</span>
              <br />
              <span>
                <%= data.attachmentName %>
              </span>
              <br />
              <br />
            </mj-text>

              <% if (data.applicant_answers_to_recruiter_questions?.length) { %>
                <mj-text mj-class="text title">
                  <%= data.applicant_answers_to_lba_questions ? "Vos motivations" : "Vos réponses aux questions de l’entreprise" %>
                  <br /><br />
                </mj-text>
                <% data.applicant_answers_to_recruiter_questions.forEach(function(answerData) { %>
                  <mj-text mj-class="text text-body">
                    <span style="font-weight: 700;"><%= answerData.question %></span>
                    <br />
                    <span>
                      <%- answerData.answer %>
                    </span>
                    <br />
                    <br />
                  </mj-text>
                <% }) %>
              <% } %>

              <% if (data.applicant_contract_duration || data.applicant_contract_start || data.applicant_formation_description || data.applicant_rythm_description) { %>
                <mj-text mj-class="text title">
                  Votre recherche d’alternance
                  <br /><br />
                </mj-text>
                <mj-text mj-class="text text-body">
              <% } %>

                <% if (data.applicant_contract_duration) { %>
                  <span style="font-weight: 700;">Durée du contrat souhaitée :</span>
                  <br />
                  <span>
                    <%= data.applicant_contract_duration %>
                  </span>
                  <br />
                  <br />
                <% } %>
                
                <% if (data.applicant_contract_start) { %>
                  <span style="font-weight: 700;">Début de contrat souhaité :</span>
                  <br />
                  <span>
                    <%= data.applicant_contract_start %>
                  </span>
                  <br />
                  <br />
                <% } %>

                <% if (data.applicant_formation_description) { %>
                  <span style="font-weight: 700;">Informations sur l’école et la formation :</span>
                  <br />
                  <span>
                    <%- data.applicant_formation_description %>
                  </span>
                  <br />
                  <br />
                <% } %>

                <% if (data.applicant_rythm_description) { %>
                  <span style="font-weight: 700;">Rythme de l’alternance (école/entreprise) :</span>
                  <br />
                  <span>
                    <%- data.applicant_rythm_description %>
                  </span>
                  <br />
                  <br />
                <% } %>
              
              <% if (data.applicant_contract_duration || data.applicant_contract_start || data.applicant_formation_description || data.applicant_rythm_description) { %>
                </mj-text>
              <% } %>


            <mj-text mj-class="text" color="#000091" font-size="16px" font-weight="700" line-height="24px">
              💡 Besoin d’aide ?
            </mj-text>
            <mj-text mj-class="text text-body">
              <a href="https://labonnealternance.apprentissage.beta.gouv.fr/guide-alternant?utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=confirmation-candidature-lien-guide-alternant" style="text-decoration: underline; color: inherit;">Consultez nos ressources</a> pour calculer votre rémunération, suivre vos candidatures ou simplement vous informer sur l’alternance.
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez candidaté à une entreprise identifiée par La bonne alternance.",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
