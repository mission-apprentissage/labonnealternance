<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Invitation MER 1" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" vertical-align="middle" padding="23px" width="100%">
            <mj-text mj-class="text text-body" padding="0px 0px 12px 0px">
              Bonjour <%= data.first_name %> <%= data.last_name %>,
              <br />
              <br />
              Vous avez publié une offre pour le poste<span style="font-weight: 700;"> <%= data.job_title %></span> le <%= data.job_creation_date %> mais il semblerait que vous recevez peu de candidatures.
              <br />
              <br />
              Pour attirer des candidats qualifiés, <span style="font-weight: 700;">partagez votre offre auprès des centres de formation d’apprentis (CFA) </span>formant sur ce métier, près de chez vous.
              <br />
            </mj-text>
            <mj-button align="center" background-color="#000091" border-radius="0px" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="16px" font-weight="700" href="<%= data.link %>" inner-padding="8px 0px 8px 0px" line-height="24px" padding="0px 0px 0px 0px" width="192px">
              Voir les CFA proches
            </mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column"  padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title">
              Rappel de l’offre
              <br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="10px 0px 0px 0px">
              Métier :
              <br />
              <span style="font-weight: 700;"><%= data.job_title %></span>
              <br />
              <br />

              Type de contrat :
              <br />
              <span style="font-weight: 700;"><%= data.job_type %></span>
              <br />
              <br />

              <% if (data.job_level_label) { %>
                Niveau de formation :
                <br />
                <span style="font-weight: 700;"><%= data.job_level_label %></span>
                <br />
                <br />
              <% } %>

              Date de début de contrat :
              <br />
              <span style="font-weight: 700;"><%= data.job_start_date %></span>
              <br />
              <br />
            </mj-text>
            <mj-button align="center" background-color="transparent" border-radius="0px" border="2px solid #000091" color="#000091" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" href="<%= data.job_url %>" inner-padding="6px 0px 6px 0px" line-height="24px" padding="0px 0px 0px 0px" width="127px">
              Voir mon offre
            </mj-button>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déposé une offre d'emploi en alternance sur La bonne alternance.",
        faqAnchor: "recruteur",
        faqUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_recruteur-partagez-votre-offre-aux-cfa_faq",
        privacyUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_recruteur-partagez-votre-offre-aux-cfa_politique-confidentialite",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
