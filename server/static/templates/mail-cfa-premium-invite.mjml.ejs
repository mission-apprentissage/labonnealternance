<mjml>
  <%- include("partials/head", {
    title: data.isParcoursup ? "Trouvez et recrutez vos candidats sur Parcoursup avec La bonne alternance" : data.isAffelnet ? "Trouvez et recrutez vos candidats sur Choisir son affectation après la 3e avec La bonne alternance" : null,
  }) %>

  <mj-body background-color="#f5f5fe" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data, utm: data.utmParams }) %>

      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" line-height="26px" padding="16px 0px 16px 0px">
              Recevez les demandes de contact des candidats sur <strong>
              <% if(data.isParcoursup){ %>Parcoursup<% } %>
              <% if(data.isAffelnet){ %>Choisir son affectation après la 3e<% } %>
              </strong> directement dans les boîtes mail de votre CFA !
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
              En activant le service, un formulaire de contact sera affiché sur vos formations dans 
              <% if(data.isParcoursup){ %><b>Parcoursup</b>.<%}%>
              <% if(data.isAffelnet){ %><b>Choisir son affectation après la 3e</b>.<%}%> 
               Les candidats intéressés pourront ainsi vous adresser leurs questions, que vous recevrez par courriel.
            </mj-text>
            <mj-button color="#ffffff" padding-top="20px" font-size="16px" font-weight="bold" padding-bottom="20px" background-color="#000091" href="<%= data.etablissement.linkToForm %>&<%= data.utmParams %>">
              Je souhaite activer le service<% if(data.isParcoursup){ %> sur Parcoursup<%}%>
            </mj-button>
            <mj-image align="center" alt="" css-class="image" padding="12px" src="<%= data.images.optoutCfa %>" width="500px"></mj-image>

            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Comment ça marche ?
              <br /><br />
            </mj-text>
						
						<mj-text font-size="16px" line-height="24px">
              En acceptant l’invitation, <span style="font-weight:bold;">un formulaire de contact sera disponible sur vos formations</span> actuelles et futures exposées sur <% if(data.isParcoursup){ %>Parcoursup<% } %><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<% } %>, rattachées à votre établissement.
              <br /><br/>
              <%= data.etablissement.name %> <br />
              <%= data.etablissement.formateur_address %><br/>
              <%= data.etablissement.formateur_zip_code %> <%= data.etablissement.formateur_city %><br/>
              SIRET : <%= data.etablissement.formateur_siret %>
              <br /><br />
              Vous recevrez les demandes des candidats à l’adresse email renseignée par votre établissement comme email de contact du lieu de formation auprès de votre <a href="https://catalogue-apprentissage.intercariforef.org/" style="color:#161616; text-decoration: 'underline';">Carif-Oref</a>.
              <br /><br />
              Ce service est proposé par <a href="https://labonnealternance.apprentissage.beta.gouv.fr/?<%= data.utmParams %>" style="color:#161616; text-decoration: 'underline';">La bonne alternance</a> pour <% if(data.isParcoursup){ %>Parcoursup<% } %> <% if(data.isAffelnet){ %>Choisir son affectation après la 3e<% } %>.
          	</mj-text>

            <mj-spacer height="24px"></mj-spacer>
                                  
            <mj-button color="#000091" font-size="16px" font-weight="bold" background-color="#ffffff" border="1px solid #000091" href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>">
              Je souhaite en savoir plus sur ce service
            </mj-button>
            <mj-spacer height="16px"></mj-spacer>
            <mj-button color="#000091" font-size="16px" font-weight="bold" background-color="#ffffff" border="1px solid #000091"  href="mailto:<%= data.publicEmail %>?subject=Email%20<% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Affelnet<%}%>%20-%20Question">
              J’ai une question
            </mj-button>
            <mj-spacer height="24px"></mj-spacer>

            <mj-text font-size="16px" line-height="24px">
              Cordialement,<br/>
              L'équipe <a href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>">La bonne alternance</a>,<br/>
            </mj-text>
          </mj-column>
        </mj-group> 
      </mj-section>
        
      <% if(data.isParcoursup){ %>
        <mj-section border-radius="4px" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" vertical-align="middle" width="100%">
          <mj-spacer height="16px"></mj-spacer>
          <mj-image align="right" alt="" css-class="image" alt="" src="<%= data.images.logoParcoursup %>" width="268px"></mj-image>
          </mj-column>
        </mj-group>
      </mj-section>
      <% } %>
    
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déclaré des formations en apprentissage auprès de votre Carif Oref.",
        utm: data.utmParams,
        legal: "tableau-de-bord",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
