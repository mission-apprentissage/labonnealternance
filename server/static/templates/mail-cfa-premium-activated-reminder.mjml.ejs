<mjml>
  <%- include("partials/head", {
    title: data.isParcoursup ? "Les candidats peuvent contacter votre CFA directement depuis Parcoursup !" : data.isAffelnet ? "Les candidats peuvent contacter votre CFA directement depuis Choisir son affectation après la 3e !" : null,
  }) %>

  <mj-body background-color="#f5f5fe" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data, utm: data.utmParams }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" line-height="26px" padding="16px 0px 16px 0px">
                Les candidats peuvent contacter votre CFA directement depuis 
                <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%> !
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
                Votre centre de formation bénéficie du service de mise en relation permettant aux candidats de contacter votre CFA sur 
                <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%>, 
                proposé par La bonne alternance. L'ouverture de la saisie des voeux sur 
                <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%> approche, préparez-vous à répondre aux sollicitations des candidats.
                <br /><br />
                Vous recevrez les demandes des candidats pour le(s) établissement(s) pour le(s)quel votre adresse email a été renseignée comme email de contact du lieu de formation auprès de votre Carif-Oref.
            </mj-text>

            <mj-image align="center" alt="" css-class="image" padding="12px" src="<%= data.images.optoutCfa %>" width="500px"></mj-image>

            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Comment ça marche ?
              <br /><br />
            </mj-text>

            <mj-text font-size="16px" line-height="24px">
              Un <strong>formulaire de contact est disponible sur les formations</strong> actuelles et futures exposées sur 
              <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%>, rattachées à votre établissement.
              <br /><br />
              Vous recevrez les demandes des candidats à l’adresse email renseignée par votre établissement comme email de contact du lieu de formation auprès de votre <a style="color:#161616; text-decoration: 'underline';" href="https://www.intercariforef.org">Carif-Oref</a>.
              <br /><br />              
              Ce service est proposé par <a style="color:#161616; text-decoration: 'underline';" href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>">La bonne alternance</a> pour 
              <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%>.
            </mj-text>

            <mj-spacer height="24px"></mj-spacer>

            <mj-button color="#000091" font-size="16px" font-weight="bold" background-color="#ffffff" border="1px solid #000091" href="https://labonnealternance.apprentissage.beta.gouv.fr/faq?<%= data.utmParams %>">
              Je souhaite en savoir plus sur ce service
            </mj-button>
            
            <mj-spacer height="24px"></mj-spacer>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-spacer height="24px"></mj-spacer>
      
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Vos engagements <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%>
              <br /><br />
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
              Ce service sur <% if(data.isParcoursup){ %>Parcoursup<%}%><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%> vous 
              engage en tant que CFA à contacter tous les candidats qui feront une demande sur la plateforme dans un délai de 4 jours ouvrés après réception de la demande par courriel.
              <br /><br />
            </mj-text>
            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Vous souhaitez modifier le mail destinataire des demandes des candidats ?
              <br /><br />
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
              Contactez notre équipe support à <a style="color:#161616; text-decoration: 'underline';" href="mailto:<%= data.publicEmail %>"><%= data.publicEmail %></a>.
              <br /><br />
              Cordialement,<br/>
              L'équipe <a href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>" style="color:#161616; text-decoration: 'underline';">La bonne alternance</a>,<br/>
            </mj-text>
          </mj-column>
        </mj-group> 
      </mj-section>

      <% if(data.isParcoursup){ %>
        <mj-section border-radius="4px" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" vertical-align="middle" width="100%">
          <mj-spacer height="16px"></mj-spacer>
          <mj-image align="right" alt="" css-class="image" alt="" src="<%= data.images.logoParcoursup %>" width="268px"></mj-image>
          </mj-column>
        </mj-group>
      </mj-section>
      <% } %>
      
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déclaré des formations en apprentissage auprès de votre Carif Oref.",
        utm: data.utmParams,
        legal: "tableau-de-bord",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
