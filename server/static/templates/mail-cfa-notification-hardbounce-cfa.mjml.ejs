<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Candidat - Echec rdva" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="10px 0px 10px 0px">
              Le centre de formation n’a pas reçu votre demande
              <br /><br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="6px 0px 6px 0px">
              Bonjour <%= data.user.firstname %> <%= data.user.lastname %>,
              <br /><br />
              Vous avez demandé un rendez-vous avec l'établissement<span style="font-weight: 700;"> <%= data.etablissement.name %>. </span>
              <br /><br />
              Malheureusement, nous n'avons pas pu transmettre votre demande pour la raison suivante :
              <br /><br />
              <span style="font-weight: 700;">
                Les coordonnées de contact dont nous disposons pour cet établissement ne sont plus valides.
              </span>
              <br />

              <% if(data.phone) { %>
              <br />
              Nous vous prions de nous excuser pour la gêne occasionnée et vous invitons à contacter l'établissement directement par téléphone au numéro suivant :
              <br /><br />
              <span style="font-weight: 700;">
                <%= data.phone %>
              </span>
              <br />
            </mj-text>
            <% } %>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="10px 0px 10px 0px">
              Rappel de votre demande
              <br />
            </mj-text>

            <mj-text mj-class="text text-body" padding="6px 0px 0px 0px">
              Date d’envoi :
              <br />
              <span style="font-weight: 700;">
              <%= data.appointment.created_at %>
              </span>
              <br /><br />


              Formation dispensée par :
              <br />
              <span style="font-weight: 700;">
              <%= data.etablissement.name %>
              </span>
              <br /><br />


              Adresse :
              <br />
            	<span style="font-weight: 700;">
              <%= data.etablissement.formateur_address %>, <%= data.etablissement.formateur_zip_code %> <%= data.etablissement.formateur_city %>
              </span>
              <br /><br />

              Motif :
              <br />
            	<span style="font-weight: 700;">
              <%= data.appointment.reasons %>
              </span>
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez contacté un centre de formation.",
        faqUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_candidat-rdva-non-remis_faq",
        privacyUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_candidat-rdva-non-remis_politique-confidentialite",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
