<mjml>
  <%- include("partials/head", {
    title: data.isParcoursup ? "Vous avez activé le service RDV Apprentissage sur Parcoursup !" : data.isAffelnet ? "Vous avez activé le service RDV Apprentissage sur Choisir son affectation après la 3e !" : null,
  }) %>

  <mj-body background-color="#f5f5fe" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data, utm: data.utmParams }) %>

      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" line-height="26px" padding="16px 0px 16px 0px">
              Les candidats peuvent contacter votre CFA directement depuis 
              <% if(data.isParcoursup){ %>
              Parcoursup !
              <% } %> <% if(data.isAffelnet){ %>
              Choisir son affectation après la 3e !
              <% } %>
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
              À votre demande, le service de mise en relation permettant aux candidats de contacter votre CFA est activé sur 
              <% if(data.isParcoursup){ %>Parcoursup<%}%>
              <% if(data.isAffelnet){ %>Choisir son affectation après la 3e<%}%> 
              pour les formations éligibles au référencement et rattachées à votre établissement :
              <br /><br/>
              <%= data.etablissement.name %> <br />
              <%= data.etablissement.formateur_address %><br/>
              <%= data.etablissement.formateur_zip_code %> <%= data.etablissement.formateur_city %><br/>
              SIRET : <%= data.etablissement.formateur_siret %>
              <br /><br />
              Si vous avez des questions ou si vous souhaitez vous désinscrire du service, envoyez un email à <a href="mailto:<%= data.publicEmail %>" style="color:#161616; text-decoration: 'underline';"><%= data.publicEmail %></a>.
              <br /><br />
          	  Cordialement,<br/>
              L'équipe <a style="color:#161616; text-decoration: 'underline';" href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>">La bonne alternance</a><br/>
            </mj-text>
          </mj-column>
        </mj-group> 
      </mj-section>
        
      <% if(data.isParcoursup){ %>
        <mj-section border-radius="4px" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" vertical-align="middle" width="100%">
          <mj-spacer height="16px"></mj-spacer>
          <mj-image align="right" alt="" css-class="image" alt="" src="<%= data.images.logoParcoursup %>" width="268px"></mj-image>
          </mj-column>
        </mj-group>
      </mj-section>
      <% } %>
    
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déclaré des formations en apprentissage auprès de votre Carif Oref.",
        utm: data.utmParams,
        legal: "tableau-de-bord",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
