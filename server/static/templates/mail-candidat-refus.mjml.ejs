<mjml>
  <%- include("partials/head", { title: `Votre candidature chez ${data.company_name}` }) %>

  <mj-body background-color="#f5f5fe" name="Candidat - Réponse négative" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column"  padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text text-body">
              Bonjour <%= data.applicant_first_name %> <%= data.applicant_last_name %>,
              <br />
              <br />

              <span style="font-weight: 700;"><%= data.company_name %></span> a bien reçu votre candidature
              <% if (data.partner) { %> <span style="font-weight: 700;">via <%= data.partner %></span> <% } %>
              et nous a fait part qu'elle ne donnerait pas suite à celle-ci.
              <br />
              <br />
                
              Voici la réponse de <% if(data.jobSourceType==="CFA") { %>l'école<% } else { %>l’entreprise<% } %> :
              <br />
              <span style="font-weight: 700;">
                <%- data.comment %></span>
              <br /><br />

              <% if (data.reasons.length > 0 ) { %>
              Le recruteur a précisé la/les raison(s) de ce refus :
              <br />

              <ul style="margin: 0; padding-left: 32px;">
                <% data.reasons.forEach(function(item) { %>
                <li style="line-height: 28px; font-weight: 700;">
                  <%= item %>
                </li>
                <% }) %>
              </ul>
              <br />
              <% } %>

            </mj-text>

            <mj-text mj-class="text text-muted">
              Ce courriel est généré automatiquement, vous ne pouvez pas y répondre.
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <mj-spacer height="24px"></mj-spacer>

      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column"  padding="23px" vertical-align="middle" width="100%">
            
            <mj-text mj-class="text title" padding="0px 0px 16px 0px">
              Prochaines étapes ?
              <br />
            </mj-text>
            
            <mj-text mj-class="text text-body" padding="0px 0px 16px 0px">
              Les refus sont courants quand on recherche une alternance, tout
              comme l’absence de réponse des recruteurs. Il ne faut pas perdre confiance et
              poursuivre vos efforts ! On vous propose les actions suivantes :
              <br />
              <br />

              ✍️ <a href="https://dinum.didask.com/courses/demonstration/60d21bf5be76560000ae916e" style="text-decoration: underline; color: inherit;">
                Optimisez votre recherche d’entreprises avec ce quiz
              </a>
              <br />
              <br />

              📝 <a href="https://www.canva.com/fr_fr/creer/cv/" style="text-decoration: underline; color: inherit;">
                Peaufinez votre curriculum vitae
              </a>
              <br />
              <br />

              🚀 <a href="https://labonnealternance.apprentissage.beta.gouv.fr/?utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_candidat-reponse-refus_lien-home" style="text-decoration: underline; color: inherit;">
                Continuer à candidater sur La bonne alternance
              </a>
              <br />
              
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>

      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez candidaté à une entreprise identifiée par La bonne alternance.",
        faqUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_candidat-reponse-refus_faq",
        privacyUtm: "utm_source=lba-brevo-transactionnel&utm_medium=email&utm_campaign=lba_candidat-emploi-reponse-refus_politique-confidentialite",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
