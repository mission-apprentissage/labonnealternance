<%#
  En-tête bloc-marque République française + La bonne alternance, suivi de l'espacement avant le contenu.
  Logos en PNG 2x affichés à la moitié de leur taille, marge transparente de 8 px incluse dans l'image.
  Paramètres : data (data.images), utm optionnel (query string sans « ? ») ajouté au lien du logo.
%>
<mj-section border-radius="0px" css-class="section">
  <mj-group>
    <mj-column border-radius="0px" css-class="column" vertical-align="middle" width="20%">
      <mj-image align="left" alt="République française" css-class="image" height="108px" src="<%= data.images.logoRf %>" width="120px"></mj-image>
    </mj-column>
    <mj-column border-radius="0px" css-class="column" padding="0px 24px 0px 8px" vertical-align="middle" width="33.17%">
      <mj-image align="left" alt="La bonne alternance" css-class="image" height="56px" href="https://labonnealternance.apprentissage.beta.gouv.fr<%= locals.utm ? `?${utm}` : "" %>" src="<%= data.images.logoLba %>" width="167px"></mj-image>
    </mj-column>
    <mj-column border-radius="0px" css-class="column" vertical-align="top" width="46.83%"></mj-column>
  </mj-group>
</mj-section>
<mj-spacer height="24px"></mj-spacer>
