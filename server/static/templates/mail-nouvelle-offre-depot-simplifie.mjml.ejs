<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Entreprise - Confirmation " width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text text-body" padding="0px 0px 24px 0px">
              Bonjour <%= data.first_name %> <%= data.last_name %>,
              <br />
              <br />
              <span style="font-weight: 700;">
                Pour finaliser la publication de votre offre, veuillez confirmer votre adresse mail</span> en cliquant sur le bouton ci-dessous :
              <br />
            </mj-text>
            <mj-button href="<%= data.confirmation_url %>" align="center" background-color="#000091" border-radius="0px" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" inner-padding="4px 8px 4px 8px" line-height="24px" padding="0px 0px 24px 0px" width="220px">
              Confirmer mon adresse mail
            </mj-button>
            <mj-text mj-class="text" color="#161616" font-size="14px" font-weight="400" line-height="22px">
              Si le bouton ne fonctionne pas, copiez le lien suivant dans votre navigateur :
              <br /><%= data.confirmation_url %>
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <% if (data.isUserAwaiting) { %>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="10px 0px 10px 0px">
              Quelles sont les prochaines étapes ?
              <br />
            </mj-text>

            <mj-text mj-class="text" color="#161616" font-size="16px" font-weight="700" line-height="28px" padding="10px 0px 0px 0px">
              Votre compte sera validé manuellement par nos équipes.
              <br />
              <br />
              Vous serez notifié par email.
              <br />
              <br />
              Votre offre sera automatiquement publiée.
              <br />
              <span style="font-weight: 400;">
                Une fois votre compte validé, votre offre est automatiquement publiée.
              </span>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <% } %>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="10px 0px 10px 0px">
              Rappel de l’offre
              <br />
            </mj-text>
            <mj-text mj-class="text text-body" padding="10px 0px 0px 0px">
              <% if (data.offre.job_title) { %>
              Titre :
              <br />
              <span style="font-weight: 700;"><%= data.offre.job_title %></span>
              <br /><br />
              <% } %>
              Métier :
              <br />
              <span style="font-weight: 700;"><%= data.offre.rome_appellation_label %></span>
              <br /><br />

              Type de contrat :
              <br />
              <span style="font-weight: 700;"><%= data.offre.job_type %></span>
              <br /><br />

              Niveau de formation :
              <br />
              <span style="font-weight: 700;"><%= data.offre.job_level_label %></span>
              <br /><br />

              Date de début de contrat :
              <br />
              <span style="font-weight: 700;"><%= data.offre.job_start_date %></span>
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <mj-spacer height="24px"></mj-spacer>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" padding="10px 0px 10px 0px">
              🎲 Préparez l'arrivée de votre futur·e alternant·e
              <br />
            </mj-text>
          </mj-column>
          <mj-column border-radius="0px" css-class="column" padding="11px 23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text text-body" line-height="28px" padding="10px 0px 10px 0px">
              Vous recrutez un·e alternant·e ? On vous accompagne dans les étapes clés de son intégration <a href="https://dinum.didask.com/courses/lalternance-pour-les-recruteurs" style="text-decoration: underline; color: inherit;">grâce à ce quiz interactif de 7 questions</a>.
              <br />
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déposé une offre d'emploi en alternance.",
        contactSubject: "Confirmez%20votre%20email",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
