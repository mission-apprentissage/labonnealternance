<mjml>
  <%- include("partials/head") %>
  <mj-body background-color="#f5f5fe" name="Recruteur - Refus d'une offre par la modération" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text text-body" padding="0px">
              Bonjour <%= data.prenom %> <%= data.nom %>,
              <br />
              <br />
              Vous avez déposé le <%= data.date_depot %> l’offre en alternance <span style="font-weight: 700;"><%= data.job_title %></span> pour l’établissement <%= data.raison_sociale %>.
              <br />
              <br />
              Nos équipes ont vérifié son contenu : elle ne peut pas être diffusée sur La bonne alternance en l’état.
            </mj-text>
            <% if (data.agent_note.length || data.comment) { %>
            <mj-table color="#161616" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="16px" line-height="24px" padding="24px 0px 0px 0px" role="presentation" width="100%">
              <tr>
                <td bgcolor="#F6F6F6" style="background-color: #F6F6F6; padding: 12px 16px;">
                  <% data.agent_note.forEach(function (lines, index) { %>
                  <p style="margin: <%= index === 0 ? 0 : 16 %>px 0 0 0;"><% lines.forEach(function (line, lineIndex) { %><% if (lineIndex) { %><br /><% } %><%= line %><% }) %></p>
                  <% }) %>
                  <% if (data.comment) { %>
                  <p style="margin: <%= data.agent_note.length ? 16 : 0 %>px 0 0 0;"><% data.comment.split(/\r?\n/).forEach(function (line, lineIndex) { %><% if (lineIndex) { %><br /><% } %><%= line %><% }) %></p>
                  <% } %>
                </td>
              </tr>
            </mj-table>
            <% } %>
            <mj-text mj-class="text text-body" padding="24px 0px 16px 0px">
              <span style="font-weight: 700;">Comment bien rédiger une offre en alternance ?</span>
              <br />
              Nous vous invitons à consulter notre article à destination des recruteurs :
            </mj-text>
            <mj-button href="<%= data.charteRedactionUrl %>" align="center" background-color="#000091" border-radius="0px" color="#ffffff" css-class="button" font-family="Arial, Helvetica, Verdana, sans-serif" font-size="14px" font-weight="700" inner-padding="4px 16px 4px 16px" line-height="24px" padding="0px 0px 0px 0px">
              Découvrir la charte de rédaction
            </mj-button>
            <mj-text mj-class="text text-body" padding="24px 0px 0px 0px">
              Vous avez une question ? Vous pouvez contacter notre équipe support à <a href="mailto:<%= data.publicEmail %>" style="text-decoration: underline; color: inherit;"><%= data.publicEmail %></a>
              <br />
              <br />
              À bientôt,
              <br />
              l’équipe La bonne alternance.
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
      <%- include("partials/footer", {
        data,
        contactReason: "Vous recevez cet e-mail car vous avez déposé une offre sur le service de dépôt d’offre de La bonne alternance.",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
