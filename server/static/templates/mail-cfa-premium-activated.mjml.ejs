<mjml>
  <%- include("partials/head", {
    title: `Le formulaire de contact La bonne alternance est activé pour votre CFA sur${data.isParcoursup ? " Parcoursup" : ""}${data.isAffelnet ? " Choisir son affectation après la 3e" : ""}`,
  }) %>

  <mj-body background-color="#f5f5fe" width="800px">
    <mj-column border-radius="0px" css-class="wrapper" padding="32px 100px 32px 100px">
      <%- include("partials/header", { data, utm: data.utmParams }) %>
      <mj-section background-color="#ffffff" border-radius="4px" border="1px solid #e3e3fd" css-class="section">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" padding="23px" vertical-align="middle" width="100%">
            <mj-text mj-class="text title" line-height="26px" padding="16px 0px 16px 0px">
                    <% if(data.isParcoursup){ %>
                        Les candidats peuvent vous contacter directement depuis  Parcoursup !
                    <% } %>
                    <% if(data.isAffelnet){ %>
                        Les candidats peuvent vous contacter directement depuis Choisir son affectation après la 3e !
                    <% } %>
            </mj-text>
            <mj-text font-size="16px" line-height="24px">
                Le <% if(data.isParcoursup){ %><%= data.etablissement.premiumActivatedDate %><% } %><% if(data.isAffelnet){ %><%= data.etablissement.premiumAffelnetActivatedDate %><% } %>, votre établissement gestionnaire a activé le service de mise en relation La bonne alternance, permettant aux candidats de vous adresser leurs questions par mail. Un formulaire de contact est ainsi ajouté à vos formations publiées sur <strong><% if(data.isParcoursup){ %>Parcoursup<% } %><% if(data.isAffelnet){ %>Choisir son affectation après la 3e<% } %></strong>. 
                <br /><br />
                Vous recevrez les demandes pour l’organisme de formation suivant :
                <br /><br />

                <%= data.etablissement.name %> <br />
                <%= data.etablissement.formateur_address %><br/>
                <%= data.etablissement.formateur_zip_code %> <%= data.etablissement.formateur_city %> <br/>
                SIRET: <%= data.etablissement.siret %>
            </mj-text>

            <mj-image align="center" alt="" css-class="image" padding="12px" src="<%= data.images.optoutCfa %>" width="500px"></mj-image>

            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Vos engagements <% if(data.isParcoursup){ %> Parcoursup<% } %><% if(data.isAffelnet){ %> Choisir son affectation après la 3e<% } %>
              <br /><br />
            </mj-text>

            <mj-text font-size="16px" line-height="24px">
              Ce service proposé par La bonne alternance vous engage en tant que CFA à contacter tous les candidats qui feront une demande sur la plateforme [nom-plateforme-educative] dans un délai de 4 jours ouvrés après réception de la demande par courriel.
              <br /><br />
            </mj-text>  

            <mj-text font-weight="bold" font-size="20px" line-height="26px">
              Comment ça marche ?
              <br /><br />
            </mj-text>

            <mj-text font-size="16px" line-height="24px">
              Vous recevrez les demandes des candidats sur l’adresse email du contact principal du lieu de formation renseigné auprès de votre <a style="color:#161616; text-decoration: 'underline';" href="https://www.intercariforef.org">Carif-Oref</a>.
              <br /><br />
            </mj-text>  

            <mj-column width="100%" background-color="#ECECFE">
              <mj-text padding="20px" color="#000091" font-style="italic" font-size="16px" line-height="24px">
                Si votre email ne correspond pas au bon contact, nous vous invitons à faire la mise à jour auprès de votre Carif Oref directement.
              </mj-text>
            </mj-column>

            <mj-spacer height="24px"></mj-spacer>
                                  
            <mj-button color="#000091" font-size="16px" font-weight="bold" background-color="#ffffff" border="1px solid #000091" href="https://labonnealternance.apprentissage.beta.gouv.fr/faq?<%= data.utmParams %>">
              Je souhaite en savoir plus sur ce service
            </mj-button>
            <mj-spacer height="16px"></mj-spacer>
            <mj-button color="#000091" font-size="16px" font-weight="bold" background-color="#ffffff" border="1px solid #000091"  href="mailto:<%= data.publicEmail %>?subject=RDVA%20Question">
              J’ai une question
            </mj-button>
            <mj-spacer height="24px"></mj-spacer>

            <mj-text font-size="16px" line-height="24px">
              Cordialement,<br/>
              L'équipe <a href="https://labonnealternance.apprentissage.beta.gouv.fr/organisme-de-formation?<%= data.utmParams %>" style="color:#161616; text-decoration: 'underline';">La bonne alternance</a>,<br/>
            </mj-text>
          </mj-column>
        </mj-group> 
      </mj-section>

      <% if(data.isParcoursup){ %>
        <mj-section border-radius="4px" css-class="section" name="mj-section_group">
        <mj-group>
          <mj-column border-radius="0px" css-class="column" vertical-align="middle" width="100%">
          <mj-spacer height="16px"></mj-spacer>
          <mj-image align="right" alt="" css-class="image" alt="" src="<%= data.images.logoParcoursup %>" width="268px"></mj-image>
          </mj-column>
        </mj-group>
      </mj-section>
      <% } %>

      <%- include("partials/footer", {
        data,
        contactReason: "Nous vous contactons car vous avez déclaré des formations en apprentissage auprès de votre Carif Oref.",
        utm: data.utmParams,
        legal: "tableau-de-bord",
      }) %>
    </mj-column>
  </mj-body>
</mjml>
