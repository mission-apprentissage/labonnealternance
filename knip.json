{
  "workspaces": {
    "server": {
      "entry": [
        "src/index.ts!",
        "src/migrations/*.ts!",
        "tests/utils/globalSetup.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "tests/**/*.ts",
        "!src/**/*.test.ts!"
      ]
    },
    "shared": {
      "entry": [
        "src/**/*.ts",
        "!src/**/*.test.ts!"
      ],
      "project": [
        "src/**/*.ts",
        "!src/**/*.test.ts!"
      ],
      "includeEntryExports": true
    },
    "ui": {
      "project": [
        "./**/*.{ts,tsx,scss,sass}",
        "!.next"
      ],
      "paths": {
        "@/*": [
          "./*"
        ]
      },
      "next": true,
      "ignoreDependencies": [
        "@sentry/cli"
      ]
    },
    ".": {
      "husky": true,
      "commitlint": true,
      "project": [
        "!.husky/commitlint.config.js"
      ],
      "ignore": [
        ".yarn/**"
      ]
    }
  }
}
