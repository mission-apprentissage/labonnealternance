# Limitation de débit par IP sur la recherche et l'autocomplétion (anti-scraping).
# Un usage humain fait des rafales courtes ; un scraper tient un débit soutenu.
# Les zones limitent donc le débit continu avec un burst généreux.
# Les dépassements sont logués dans error.log et alimentent le jail fail2ban
# nginx-req-limit (ban iptables 1h au-delà de 50 dépassements sur 1h), sauf les zones _recherche.

# Les IPs internes (healthchecks, réseau docker) ne sont pas limitées, ni celles de
# LBA_NGINX_RATELIMIT_ALLOWLIST (env chiffré, IP séparées par des virgules) : serveurs
# qui agrègent plusieurs consommateurs, limités en amont (cf. issue #4806).
geo $lba_limited {
    default        1;
    127.0.0.1      0;
    10.0.0.0/8     0;
    172.16.0.0/12  0;
    192.168.0.0/16 0;
{% for ip in (LBA_NGINX_RATELIMIT_ALLOWLIST | default('')).split(',') if ip | trim %}
    {{ ip | trim }} 0;
{% endfor %}
}

map $lba_limited $lba_limit_key {
    0 "";
    1 $binary_remote_addr;
}

# Recherche du site (cf. locations/90_location_ui.conf.template). Les zones suffixées _recherche ne
# déclenchent pas de ban : le filtre fail2ban nginx-req-limit les ignore (repo infra), car une IP de relais
# partagée (iCloud Private Relay, Cloudflare WARP, réseau d'établissement) bannie couperait tout le site à
# ses autres utilisateurs. La preuve de travail et le quota par jeton tiennent le débit des aspirateurs.
# Émission des jetons de recherche (/bff/jeton) : un jeton couvre 100 recherches.
limit_req_zone $lba_limit_key zone=lba_jeton_recherche:10m rate=10r/m;
# Rendu des pages /recherche (navigation, filtres, widget).
limit_req_zone $lba_limit_key zone=lba_rendu_recherche:10m rate=60r/m;

# Autocomplétion métiers (/api/rome) : 1 appel par frappe, rafales tolérées.
limit_req_zone $lba_limit_key zone=lba_autocomplete:10m rate=2r/s;

# Liens partenaires (/monmaster/<RNCP>) : un usager clique une fois depuis le site partenaire.
# Débit bas pour qu'une énumération des codes RNCP finisse dans le jail fail2ban.
limit_req_zone $lba_limit_key zone=lba_partner_links:10m rate=6r/m;

# limit_req_status 429 déjà défini globalement par l'image du reverse proxy
# (/etc/nginx/extra-conf.d/limit_req.conf dans le conteneur, hors de ce repo) :
# ne pas le redéclarer ici sous peine de "directive is duplicate" au reload nginx.
