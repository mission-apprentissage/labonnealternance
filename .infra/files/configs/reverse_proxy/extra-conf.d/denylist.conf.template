# IP refusées sur tout le site (403, cf. locations/00_denylist.conf.template). Liste séparée par des virgules
# dans LBA_NGINX_DENYLIST (env chiffré) ; vide par défaut.
geo $lba_denied {
    default 0;
{% for ip in (LBA_NGINX_DENYLIST | default('')).split(',') if ip | trim %}
    {{ ip | trim }} 1;
{% endfor %}
}
