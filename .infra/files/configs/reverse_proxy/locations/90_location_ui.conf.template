location / {
    set $upstream http://ui:3000;
    include includes/proxy.conf;

    client_max_body_size 0;

    # Next 16 répond 500 quand le slug d'une fiche n'est pas décodable, avant même d'appeler proxy.ts :
    # UTF-8 invalide (liens partenaires encodés en Latin-1, `%E9`) ou `%` littéral, que cacheComponents
    # décode une seconde fois. Le slug est décoratif : on redirige vers la fiche avec un slug neutre (#5456).
    # La regex porte sur $uri, décodé ; l'id est repris brut de $request_uri pour rester encodé.
    # Location relative : en absolu, nginx y mettrait son port d'écoute interne.
    location ~ "^/(?:emploi/[^/]+/[^/]+|formation/[^/]+)/(?!(?:[\x00-\x24\x26-\x7F]|[\xC2-\xDF][\x80-\xBF]|\xE0[\xA0-\xBF][\x80-\xBF]|[\xE1-\xEC\xEE\xEF][\x80-\xBF]{2}|\xED[\x80-\x9F][\x80-\xBF]|\xF0[\x90-\xBF][\x80-\xBF]{2}|[\xF1-\xF3][\x80-\xBF]{3}|\xF4[\x80-\x8F][\x80-\xBF]{2})*$)" {
        absolute_redirect off;
        if ($request_uri ~ "^/(emploi/[^/?]+/[^/?]+)/") {
            return 308 /$1/offre$is_args$args;
        }
        if ($request_uri ~ "^/(formation/[^/?]+)/") {
            return 308 /$1/formation$is_args$args;
        }
        set $upstream http://ui:3000;
        include includes/proxy.conf;
    }

    # Liens partenaires (/monmaster/<RNCP>) : chaque clic déclenche une résolution côté API, débit borné
    # par IP contre l'énumération des codes (zone dans extra-conf.d/rate-limit.conf.template).
    location /monmaster/ {
        if ($lba_denied) {
            return 403;
        }

        limit_req zone=lba_partner_links burst=10 nodelay;

        set $upstream http://ui:3000;
        include includes/proxy.conf;
    }

    location /recherche {
        limit_req zone=lba_rendu_recherche burst=120 nodelay;
        error_page 429 = @lba_limite_rendu_recherche;

        set $upstream http://ui:3000;
        include extra-includes/proxy-iframe.conf;
    }

    # Émission des jetons de recherche (défi ALTCHA puis échange de la solution, cf. ui/app/bff/jeton).
    location = /bff/jeton {
        limit_req zone=lba_jeton_recherche burst=20 nodelay;
        error_page 429 = @lba_limite_jeton_recherche;

        set $upstream http://ui:3000;
        include includes/proxy.conf;
    }

    location /recherche-emploi {
        set $upstream http://ui:3000;
        include extra-includes/proxy-iframe.conf;
    }

    location /recherche-formation {
        set $upstream http://ui:3000;
        include extra-includes/proxy-iframe.conf;
    }

    location /postuler {
        set $upstream http://ui:3000;
        include extra-includes/proxy-iframe.conf;
    }

    location /espace-pro/widget {
        set $upstream http://ui:3000;
        include extra-includes/proxy-iframe.conf;
    }
}

# Réponses des limites sans ban (zones _recherche, cf. extra-conf.d/rate-limit.conf.template) : l'en-tête
# X-LBA-Limite nomme la limite atteinte.
location @lba_limite_jeton_recherche {
    default_type application/json;
    add_header X-LBA-Limite jeton_recherche always;
    return 429 '{"statusCode":429,"error":"Too Many Requests","message":"limite jeton_recherche"}';
}

location @lba_limite_rendu_recherche {
    default_type text/plain;
    add_header X-LBA-Limite rendu_recherche always;
    return 429 'Trop de requêtes, réessayez dans une minute.';
}
