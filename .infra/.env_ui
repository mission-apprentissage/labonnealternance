# Do not add NEXT_PUBLIC_ env as they won't be available on build time
# If you need to add public env, use config.public.ts file instead
# Clés des jetons de recherche, identiques à celles du serveur (cf. shared/utils/search-token).
LBA_SEARCH_TOKEN_KEYS={{ LBA_SEARCH_TOKEN_KEYS }}
# API sur le réseau docker pour le rendu serveur et le BFF ; vide ailleurs (URL publique).
LBA_INTERNAL_API_URL={{ "http://server:5000/api" if env_type in ["production", "recette"] else "" }}
